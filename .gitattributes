# Git LFS — track large binary model files
checkpoints/*.joblib filter=lfs diff=lfs merge=lfs -text
checkpoints/*.h5     filter=lfs diff=lfs merge=lfs -text
checkpoints/*.pkl    filter=lfs diff=lfs merge=lfs -text
checkpoints/*.npy    filter=lfs diff=lfs merge=lfs -text
outputs/data/dataset.csv filter=lfs diff=lfs merge=lfs -text

# Enforce LF line endings for shell scripts to prevent breakage on Linux/Codespaces
*.sh text eol=lf
